# All variables are optional; defaults work for the local Hardhat setup.
# Everything prefixed VITE_ is embedded in the public JS bundle: never put
# secrets here.

# JSON-RPC endpoint used for read-only verification. "/rpc" is proxied by
# Vite to RPC_PROXY_TARGET (dev and preview servers).
VITE_RPC_URL=/rpc
RPC_PROXY_TARGET=http://127.0.0.1:8545

# RPC URL suggested to MetaMask if it does not know the chain yet.
VITE_WALLET_RPC_URL=http://127.0.0.1:8545
VITE_CHAIN_NAME=Hardhat Localhost

# Base URL put into verification links and QR codes. Set this to an address
# verifiers can reach (e.g. http://192.168.1.20:5173) when issuing from
# "localhost".
VITE_PUBLIC_BASE_URL=
